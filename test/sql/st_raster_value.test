# name: test/sql/st_raster_value.test
# description: ST_RasterValue(block, band, point, metadata[, band_name]) against
#              a decode-once reference. ST_RasterValue caches the last decoded
#              tile per thread (issue #34); every point is evaluated against
#              both gzip tiles, over more rows than one chunk holds, so the
#              results must match on cache hits, misses and across chunks.
# group: [raquet]

require raquet

require parquet

statement ok
CREATE TABLE tiles AS
SELECT block, band_1, (SELECT metadata FROM 'test/data/raquet_test.parquet' WHERE block = 0) AS metadata
FROM 'test/data/raquet_test.parquet'
WHERE block != 0;

# A 48x48 grid of points over the raster bounds: 4608 (point, tile) pairs,
# more than one 2048-row chunk
statement ok
CREATE TABLE pts AS
SELECT row_number() OVER () AS id,
       13.00025 + i * (0.016 / 48) AS lon,
       52.48425 + j * (0.016 / 48) AS lat
FROM range(48) a(i), range(48) b(j);

# Reference: decode each tile once and pick the pixel of each point that falls
# in it (NULL for nodata 0, and for points outside the tile)
statement ok
CREATE TABLE expected AS
WITH decoded AS (
    SELECT block, raquet_decode_band(band_1, 'uint8', 256, 256, 'gzip') AS pixels FROM tiles
)
SELECT p.id, d.block,
       CASE WHEN quadbin_from_lonlat(p.lon, p.lat, 10) = d.block
            THEN NULLIF(d.pixels[(quadbin_pixel_xy(p.lon, p.lat, 10, 256)).pixel_y * 256
                                 + (quadbin_pixel_xy(p.lon, p.lat, 10, 256)).pixel_x + 1], 0)
       END AS value
FROM pts p, decoded d;

# Points against both tiles
statement ok
CREATE TABLE pairs AS
SELECT p.id, t.block, t.band_1, t.metadata, ('POINT(' || p.lon || ' ' || p.lat || ')')::GEOMETRY AS geom
FROM pts p, tiles t
ORDER BY p.id, t.block;

# Both overloads agree with the reference on every (point, tile) pair
query III
SELECT count(*),
       count(*) FILTER (WHERE ST_RasterValue(x.block, x.band_1, x.geom, x.metadata) IS DISTINCT FROM e.value),
       count(*) FILTER (WHERE ST_RasterValue(x.block, x.band_1, x.geom, x.metadata, 'band_1') IS DISTINCT FROM e.value)
FROM pairs x JOIN expected e USING (id, block);
----
4608	0	0

# The comparison is not vacuous: some points hit valid pixels
query I
SELECT count(*) > 0 FROM expected WHERE value IS NOT NULL;
----
true

# An unknown band name still returns NULL
query I
SELECT count(*) FROM pairs WHERE ST_RasterValue(block, band_1, geom, metadata, 'nope') IS NOT NULL;
----
0

# A band holding an empty zlib stream (8 bytes, stored inline by DuckDB) has
# no pixels: NULL, on its own and mixed with real tiles of the same chunk
query II
SELECT count(*) FILTER (WHERE v IS NULL AND empty_band), count(*) FILTER (WHERE v IS DISTINCT FROM e.value AND NOT empty_band)
FROM (
    SELECT x.id, x.block, x.id % 3 = 0 AS empty_band,
           ST_RasterValue(x.block, CASE WHEN x.id % 3 = 0 THEN from_base64('eNoDAAAAAAE=') ELSE x.band_1 END,
                          x.geom, x.metadata) AS v
    FROM pairs x
) r JOIN expected e USING (id, block);
----
1536	0
